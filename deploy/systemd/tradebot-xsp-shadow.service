[Unit]
Description=Advance the selected XSP dual-clock observer and cash transport
Wants=network-online.target
After=network-online.target tradebot-ib-gateway.service
OnFailure=tradebot-operator-alert@xsp-runtime-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/py/tradebot
Environment=PATH=%h/.local/share/tradebot/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=IBKR_HOST=127.0.0.1
Environment=IBKR_PORT=4001
Environment=IBKR_READONLY=1
Environment=IBKR_ACCOUNT_BOOTSTRAP=0
Environment=TRADEBOT_IB_PREFLIGHT_RECEIPT=%t/tradebot-ib-preflight.json
Environment=TRADEBOT_IB_PREFLIGHT_MAX_AGE_SEC=108000
ExecStartPre=/usr/bin/test -f %h/Desktop/py/tradebot/tradebot/research/xsp_dual_clock.py
ExecStartPre=/usr/bin/test -x %h/.local/share/tradebot/venv/bin/python
ExecStartPre=/usr/bin/env python3 -m tradebot.live.ib_preflight require reduction --con-id 61228752 --con-id 828937771 --receipt %t/tradebot-ib-preflight.json
ExecStart=/usr/bin/flock --exclusive --wait 180 %t/tradebot-live-account.lock /usr/bin/env python3 -m tradebot.research.xsp_shadow --mode opening-edge-p009
TimeoutStartSec=8min
KillSignal=SIGTERM
Nice=5
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
