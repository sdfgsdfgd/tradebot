[Unit]
Description=Record prospective SPY/UPRO/SPXU pressure microstructure
Wants=network-online.target
After=network-online.target tradebot-ib-gateway.service
PartOf=tradebot-live.target
OnFailure=tradebot-operator-alert@xsp-runtime-failed.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/Desktop/py/tradebot
Environment=PATH=%h/.local/share/tradebot/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=IBKR_HOST=127.0.0.1
Environment=IBKR_PORT=4001
Environment=IBKR_CLIENT_ID=3217
Environment=IBKR_PROXY_CLIENT_ID=3218
Environment=IBKR_CLIENT_ID_POOL_START=3217
Environment=IBKR_CLIENT_ID_POOL_END=3219
Environment=IBKR_CLIENT_ID_STATE_FILE=%t/tradebot-xsp-pressure-client-ids.json
Environment=IBKR_READONLY=1
Environment=IBKR_ACCOUNT_BOOTSTRAP=0
Environment=XSP_PRESSURE_TAPE_DIR=%h/.local/state/tradebot/research/xsp_pressure_tape
ExecStartPre=/usr/bin/test -f %h/Desktop/py/tradebot/backtests/xsp/opening_edge_v3_pressure_tape_generation.json
ExecStartPre=/usr/bin/test -x %h/.local/share/tradebot/venv/bin/python
ExecStart=/usr/bin/env python3 -m tradebot.research.xsp_pressure_tape --generation backtests/xsp/opening_edge_v3_pressure_tape_generation.json
Restart=no
RestartForceExitStatus=1
RestartSec=10s
RuntimeMaxSec=6h50m
TimeoutStopSec=30s
KillSignal=SIGTERM
Nice=5
IOSchedulingClass=best-effort
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
