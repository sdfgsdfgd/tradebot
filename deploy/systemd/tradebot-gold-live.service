[Unit]
Description=Reconcile the selected 1OZ Stage-76 live canary
Wants=network-online.target
After=network-online.target tradebot-ib-gateway.service
OnFailure=tradebot-operator-alert@gold-runtime-failed.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/py/tradebot
Environment=PATH=%h/.local/share/tradebot/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=IBKR_HOST=127.0.0.1
Environment=IBKR_PORT=4001
Environment=IBKR_CLIENT_ID=3207
Environment=IBKR_READONLY=0
Environment=TRADEBOT_IB_PREFLIGHT_RECEIPT=%t/tradebot-ib-preflight.json
Environment=TRADEBOT_IB_PREFLIGHT_MAX_AGE_SEC=108000
ExecStartPre=/usr/bin/test -f %h/Desktop/py/tradebot/db/calibration/live_capital_plan.json
ExecStartPre=/usr/bin/test -x %h/.local/share/tradebot/venv/bin/python
ExecStartPre=/usr/bin/env python3 -m tradebot.live.ib_preflight require reduction --con-id 753716608 --receipt %t/tradebot-ib-preflight.json
ExecStart=/usr/bin/flock --exclusive --wait 180 %t/tradebot-live-account.lock /usr/bin/env python3 -m tradebot.research.gold_live_cli
TimeoutStartSec=5min
KillSignal=SIGTERM
Nice=5
IOSchedulingClass=best-effort
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
