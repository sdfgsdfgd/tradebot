[Unit]
Description=Start the prospective XSP pressure tape before each cash session
PartOf=tradebot-live.target

[Timer]
OnCalendar=Mon..Fri *-*-* 09:20:00 America/New_York
AccuracySec=15s
RandomizedDelaySec=0
Persistent=true
Unit=tradebot-xsp-pressure-tape.service

[Install]
WantedBy=tradebot-live.target
