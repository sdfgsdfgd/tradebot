[Unit]
Description=Record one restart-safe XSP option tape across the exchange session
Wants=network-online.target
Requires=tradebot-ib-gateway-tunnel.service
After=network-online.target tradebot-ib-gateway-tunnel.service
ConditionPathExists=%h/Desktop/py/tradebot/tradebot/backtest/tools/record_quotes.py

[Service]
Type=simple
WorkingDirectory=%h/Desktop/py/tradebot
Environment=PATH=%h/.local/share/tradebot/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=IBKR_HOST=127.0.0.1
Environment=IBKR_PORT=4001
Environment=IBKR_READONLY=1
ExecCondition=/usr/bin/test -x %h/.local/share/tradebot/venv/bin/python
ExecStart=/usr/bin/env python3 -m tradebot.backtest.tools.record_quotes --symbol XSP --exchange CBOE --md-type 3 --dte 0 --moneyness 1,2.5,5 --interval 300 --count 0 --out-dir db/quotes
Restart=on-failure
RestartSec=30s
RuntimeMaxSec=20h50m
TimeoutStopSec=30s
KillSignal=SIGTERM
Nice=5
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
