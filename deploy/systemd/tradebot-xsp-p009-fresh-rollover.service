[Unit]
Description=Publish the selected flat-first XSP P-009 successor
Wants=network-online.target
After=network-online.target tradebot-ib-gateway.service tradebot-ib-preflight.service
OnFailure=tradebot-operator-alert@xsp-runtime-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/py/tradebot
Environment=PATH=%h/.local/share/tradebot/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -x /var/tmp/tradebot_xsp_p009_fresh_rollover.sh
ExecStart=/var/tmp/tradebot_xsp_p009_fresh_rollover.sh
TimeoutStartSec=15min
Nice=5
IOSchedulingClass=best-effort
PrivateTmp=false
NoNewPrivileges=true
UMask=0077
